rules_version = '2';

// TeamPulse writes to Firestore only through the backend service account,
// which bypasses these rules. They exist as a deny-by-default backstop so that
// a leaked client credential cannot read work records directly: all
// authorization decisions live in app/services/authz.py.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
