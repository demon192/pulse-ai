# ---------------------------------------------------------------------------
# TeamPulse AI configuration. Copy to .env and fill in. Placeholders only here.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
ENVIRONMENT=local                 # local | staging | production
LOG_LEVEL=INFO
APP_NAME=TeamPulse AI

# --- Data access -----------------------------------------------------------
DATA_BACKEND=memory               # memory | firestore
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_PREFIX=      # e.g. "staging_" to share one project

# --- Authentication ---------------------------------------------------------
AUTH_MODE=dev                     # dev | firebase. Forced to firebase in production.
FIREBASE_PROJECT_ID=
# Development persona switcher. Forced off when ENVIRONMENT=production.
DEV_AUTH_ENABLED=true
# POST /api/admin/seed. Forced off when ENVIRONMENT=production.
SEED_ENDPOINT_ENABLED=true

# --- Gemini -----------------------------------------------------------------
# Verify the current model list before changing GEMINI_MODEL — Google retires
# model ids over time (gemini-3.5-flash is deprecated and routes to 3.6-flash):
#   https://ai.google.dev/gemini-api/docs/models
GEMINI_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
AI_CACHE_TTL_SECONDS=900
# Use Vertex AI instead of the Gemini Developer API (no API key needed; uses ADC)
GEMINI_USE_VERTEX=false
GEMINI_VERTEX_PROJECT=
GEMINI_VERTEX_LOCATION=us-central1

# --- HTTP --------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Serve the built frontend from the same container (set true for Cloud Run)
SERVE_FRONTEND=false
FRONTEND_DIST_DIR=static

# --- Demo data ----------------------------------------------------------------
# Labels synthetic records in the UI and auto-seeds the in-memory backend.
DEMO_DATA_MODE=true
